---
layout: null
permalink: /search.json
sitemap: false
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | jsonify }},"tags":{{ post.tags | jsonify }},"content":{{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%Y-%m-%d' | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
